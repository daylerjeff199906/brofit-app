{
  "name": "brofit",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "pnpm --filter @brofit/web dev",
    "dev:api": "pnpm --filter @brofit/api dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "pnpm --filter @brofit/api exec tsx --test ../../tests/*.test.ts",
    "db:seed": "pnpm --filter @brofit/api exec tsx prisma/seed.ts",
    "db:generate": "pnpm --filter @brofit/api exec prisma generate",
    "services:down": "docker compose -f infra/compose.yaml down",
    "db:migrate": "pnpm --filter @brofit/api exec prisma migrate deploy",
    "test:browser": "playwright test",
    "setup": "node scripts/setup-local.mjs",
    "services:up": "docker compose -f infra/compose.yaml up -d",
    "test:integration": "pnpm --filter @brofit/api build && node scripts/test-integration.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.0",
    "eslint": "^9.39.5",
    "prettier": "^3.8.0",
    "turbo": "^2.8.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.2"
  }
}
